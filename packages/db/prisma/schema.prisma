// Swellwright data model. The design is docs/en/design/02-data-model.md; this file grows entity by entity.
// Tables and columns are snake_case in the database and camelCase in the client.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Built-in roles (docs/en/design/05-security.md). Their permission sets live in packages/contracts (ADR 0015);
/// custom roles come with user management.
enum UserRole {
  owner
  operator
  observer
  terminal
  auditor

  @@map("user_role")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// How far a session got. `password_verified` is usable only to finish signing in.
enum SessionStage {
  password_verified
  active

  @@map("session_stage")
}

model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Login name. Stored lower-case: the application normalizes it before every write.
  username    String     @unique @db.VarChar(32)
  displayName String?    @map("display_name") @db.VarChar(100)
  /// Optional. Stored lower-case, like the username.
  email       String?    @unique @db.VarChar(254)
  role        UserRole
  status      UserStatus @default(active)
  /// The language the person chose; null until they do (the console then follows the browser, ADR 0026).
  language    String?    @db.VarChar(16)
  theme       String     @default("dark") @db.VarChar(16)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential    Credential?
  recoveryCodes RecoveryCode[]
  sessions      Session[]
  invitation    Invitation?
  apiTokens     ApiToken[]

  @@map("users")
}

/// Why an invitation was issued: a new user, or a reset of an existing one's credentials (ADR 0016).
enum InvitationPurpose {
  invite
  reset

  @@map("invitation_purpose")
}

/// The one open invitation of a user: a one-time token to choose a password. Only the SHA-256 of the token
/// is stored; the row is deleted when the token is used, and a new invitation replaces the old one.
model Invitation {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  tokenHash   String            @unique @map("token_hash") @db.VarChar(64)
  purpose     InvitationPurpose
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The owner who issued it; null when it came from the server command. No foreign key, like the audit chain.
  createdById String?           @map("created_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("invitations")
}

/// Sign-in secrets of one user (docs/en/design/02-data-model.md, ADR 0014).
model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  /// Argon2id hash in PHC string format; carries its own salt and parameters.
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  /// TOTP secret sealed with the instance authentication key (AES-256-GCM). Null until enrollment starts.
  totpSecret        Bytes?    @map("totp_secret")
  /// Set when the user proved they hold the authenticator. Until then the secret is only a proposal.
  totpConfirmedAt   DateTime? @map("totp_confirmed_at") @db.Timestamptz(3)
  /// Time step of the last accepted code; a code is accepted only for a later step (no replay).
  totpLastStep      Int?      @map("totp_last_step")
  /// Consecutive failures of the password or the second step; reset on a completed sign-in.
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// One-time codes for a lost authenticator. Only SHA-256 hashes are stored.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// What happened to an action an audit event describes.
enum AuditOutcome {
  success
  failure
  denied

  @@map("audit_outcome")
}

/// One row of the append-only audit chain (docs/adr/0015-permissions-and-the-audit-chain.md). Nothing here
/// points at another table on purpose: the record must outlive the user it names. The migration installs
/// triggers that refuse UPDATE, DELETE and TRUNCATE; they are not part of this schema, so do not drop them.
model AuditEvent {
  /// Position in the chain, from 1, assigned under a lock so there are no gaps.
  seq        BigInt       @id
  occurredAt DateTime     @map("occurred_at") @db.Timestamptz(3)
  actorId    String?      @map("actor_id") @db.Uuid
  /// The login name when the event happened.
  actorName  String?      @map("actor_name") @db.VarChar(64)
  action     String       @db.VarChar(64)
  outcome    AuditOutcome
  objectType String?      @map("object_type") @db.VarChar(32)
  objectId   String?      @map("object_id") @db.VarChar(64)
  ip         String?      @db.VarChar(64)
  requestId  String?      @map("request_id") @db.VarChar(64)
  /// Canonical JSON text, exactly what the hash covers. Text, not jsonb: reading it back must not reorder it.
  details    String       @default("{}")
  prevHash   String       @map("prev_hash") @db.VarChar(64)
  hash       String       @unique @db.VarChar(64)

  @@index([action, seq])
  @@index([actorId, seq])
  @@map("audit_events")
}

/// What a secret is for (docs/en/design/02-data-model.md). A closed list; a new kind is a migration.
enum SecretType {
  panel_token
  ssh_key
  ssh_password
  ssh_ca
  dns_oauth
  provider_token
  telegram
  generic

  @@map("secret_type")
}

/// The one row that says how the vault opens (docs/adr/0018). The KEK is random; it is stored wrapped twice,
/// under a key derived from the owner's passphrase and under the recovery key. Never the KEK itself.
model VaultMeta {
  /// Always 1: the migration adds a check that there is only one row.
  id                  Int      @id @default(1)
  kdfSalt             Bytes    @map("kdf_salt")
  /// Argon2id parameters, kept so they can be raised later without losing the ability to open the vault.
  kdfMemoryKib        Int      @map("kdf_memory_kib")
  kdfPasses           Int      @map("kdf_passes")
  kdfParallelism      Int      @map("kdf_parallelism")
  passphraseWrappedKek Bytes   @map("passphrase_wrapped_kek")
  recoveryWrappedKek  Bytes    @map("recovery_wrapped_kek")
  kekVersion          Int      @default(1) @map("kek_version")
  /// When each part of the vault was last rotated (ADR 0024). Null: never since the vault was set up.
  passphraseChangedAt  DateTime? @map("passphrase_changed_at") @db.Timestamptz(3)
  recoveryKeyRotatedAt DateTime? @map("recovery_key_rotated_at") @db.Timestamptz(3)
  kekRotatedAt         DateTime? @map("kek_rotated_at") @db.Timestamptz(3)
  dataKeysRotatedAt    DateTime? @map("data_keys_rotated_at") @db.Timestamptz(3)
  /// The owner who set the vault up. No foreign key, like the audit chain.
  createdById         String?  @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("vault_meta")
}

/// One secret. The value is encrypted with its own data key, which is wrapped under the KEK; the name, type
/// and dates are not secret. Only the metadata is ever returned by a list.
model Secret {
  id             String     @id @default(uuid(7)) @db.Uuid
  name           String     @unique @db.VarChar(100)
  type           SecretType
  description    String?    @db.VarChar(500)
  /// Moves forward with every new value; part of what the blobs are bound to.
  version        Int        @default(1)
  /// AES-256-GCM under the data key.
  ciphertext     Bytes
  /// The data key, AES-256-GCM under the KEK.
  wrappedDek     Bytes      @map("wrapped_dek")
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(3)
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When the value last changed (created or replaced), as opposed to the metadata.
  valueChangedAt DateTime   @default(now()) @map("value_changed_at") @db.Timestamptz(3)

  /// The access entries of servers that log in with this secret, and those that use it as the sudo password.
  /// Both relations restrict: a secret in use cannot be deleted (ADR 0034).
  serverAccess     ServerAccess[] @relation("ServerAccessSecret")
  serverSudoAccess ServerAccess[] @relation("ServerAccessSudoSecret")
  /// The command runs that were handed this secret as a file (ADR 0042). A secret that a run which is not over
  /// has is not replaced or deleted; the history of finished runs keeps the name and lets the secret go.
  runSecrets       CommandRunSecret[]
  /// The connections to a panel that use this secret as their token. Restricts too (ADR 0041).
  panelConnections PanelConnection[] @relation("PanelConnectionToken")

  @@index([type])
  @@map("secrets")
}

/// A browser session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  tokenHash         String       @unique @map("token_hash") @db.VarChar(64)
  stage             SessionStage
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Idle expiry, moved forward while the session is used.
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  /// The session ends here whatever its activity.
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  /// The session counts as freshly verified until then (step-up authentication, ADR 0017). Null: never elevated.
  elevatedUntil     DateTime?    @map("elevated_until") @db.Timestamptz(3)
  ip                String?      @db.VarChar(64)
  userAgent         String?      @map("user_agent") @db.VarChar(256)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// An API token (ADR 0023): a bearer credential for the CLI and integrations, issued in the name of a user. Only
/// the SHA-256 hash of the token is kept; the token itself is shown once at creation.
model ApiToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(64)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  /// The first characters of the token, so a person can recognise it in a list. Not enough to guess it.
  prefix      String    @db.VarChar(16)
  /// What the token may do: a subset of the permissions of the owner, never one that needs a step-up.
  permissions String[]
  /// CIDR ranges the token may be used from. Empty: from anywhere.
  ipAllowlist String[]  @map("ip_allowlist")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  lastUsedIp  String?   @map("last_used_ip") @db.VarChar(64)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// What an administrator approved for a plugin: its files, by digest, and the permissions of its manifest at that
/// moment (ADR 0027). A plugin runs only while it is `enabled` and its files still have this digest.
model PluginApproval {
  pluginId    String   @id @map("plugin_id") @db.VarChar(48)
  enabled     Boolean
  version     String   @db.VarChar(64)
  trust       String   @db.VarChar(16)
  /// SHA-256 over every file of the plugin.
  digest      String   @db.VarChar(64)
  /// The approved permissions: the canonical JSON text of the manifest's `permissions`.
  permissions String
  approvedAt  DateTime @map("approved_at") @db.Timestamptz(3)
  /// The user name at the time. No foreign key, like the audit log: deleting the user does not erase who approved.
  approvedBy  String   @map("approved_by") @db.VarChar(64)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("plugin_approvals")
}

/// What an administrator entered in a plugin's settings (ADR 0029). A secret field holds the id of a vault secret,
/// never its value.
model PluginConfig {
  pluginId  String   @id @map("plugin_id") @db.VarChar(48)
  /// The settings as canonical JSON text.
  settings  String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// The user name at the time. No foreign key, like the audit log.
  updatedBy String   @map("updated_by") @db.VarChar(64)

  @@map("plugin_configs")
}

/// A plugin's own key-value storage (ADR 0029): no other plugin and no part of the core reads it.
model PluginStorageItem {
  pluginId  String   @map("plugin_id") @db.VarChar(48)
  key       String   @db.VarChar(128)
  /// JSON text.
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([pluginId, key])
  @@map("plugin_storage")
}

/// Where a server is in its life (docs/en/design/02-data-model.md). Any state may follow any other; the workflows of
/// later phases will constrain that where it matters.
enum ServerState {
  draft
  provisioning
  active
  draining
  retired

  @@map("server_state")
}

/// How Swellwright logs in to a server. Certificates come later, with a migration.
enum AccessMethod {
  password
  key

  @@map("access_method")
}

/// A server of the fleet: what it is and how to reach it (ADR 0034). What was found on it is a `ServerFact`.
model Server {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String      @unique @db.VarChar(64)
  /// A host name, an IPv4 or an IPv6 address; what SSH connects to.
  address     String      @db.VarChar(255)
  sshPort     Int         @default(22) @map("ssh_port")
  /// ISO 3166-1 alpha-2, upper case.
  country     String?     @db.VarChar(2)
  provider    String?     @db.VarChar(64)
  state       ServerState @default(draft)
  tags        String[]
  notes       String?     @db.VarChar(2000)
  /// The user who added it. No foreign key, like the audit chain: removing the user keeps the server.
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  hostKeys       ServerHostKey[]
  access         ServerAccess[]
  fact           ServerFact?
  commandTargets CommandRunTarget[]
  artifacts      ServerArtifact[]

  @@index([state])
  @@index([tags], type: Gin)
  @@map("servers")
}

/// A pinned SSH host key of a server. A connection is trusted only when the key it shows is pinned here.
model ServerHostKey {
  id                String   @id @default(uuid(7)) @db.Uuid
  serverId          String   @map("server_id") @db.Uuid
  /// The key type as OpenSSH names it, for example `ssh-ed25519`.
  algorithm         String   @db.VarChar(32)
  /// OpenSSH style: `SHA256:` and 43 base64 characters, no padding.
  fingerprintSha256 String   @map("fingerprint_sha256") @db.VarChar(50)
  /// How the key got here: `manual` (typed in) now; `scan` when the SSH layer reads it from the server.
  source            String   @default("manual") @db.VarChar(16)
  /// The user who pinned it. No foreign key, like the audit chain.
  acceptedById      String?  @map("accepted_by_id") @db.Uuid
  acceptedAt        DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, fingerprintSha256])
  @@map("server_host_keys")
}

/// One way to log in to a server. Holds references to vault secrets, never a value; the secrets cannot be deleted
/// while an entry names them.
model ServerAccess {
  id             String       @id @default(uuid(7)) @db.Uuid
  serverId       String       @map("server_id") @db.Uuid
  method         AccessMethod
  username       String       @db.VarChar(64)
  /// The password (`ssh_password`) or the private key (`ssh_key`), by method.
  secretId       String       @map("secret_id") @db.Uuid
  /// The password to use for `sudo` (`ssh_password`), when it differs from the login.
  sudoSecretId   String?      @map("sudo_secret_id") @db.Uuid
  /// Lower first: the order in which the entries are tried.
  priority       Int          @default(0)
  /// When the entry was last tried (the verify operation) and whether it logged in and ran its checks.
  lastVerifiedAt DateTime?    @map("last_verified_at") @db.Timestamptz(3)
  lastVerifyOk   Boolean?     @map("last_verify_ok")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  server     Server  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  secret     Secret  @relation("ServerAccessSecret", fields: [secretId], references: [id], onDelete: Restrict)
  sudoSecret Secret? @relation("ServerAccessSudoSecret", fields: [sudoSecretId], references: [id], onDelete: Restrict)

  @@index([serverId, priority])
  @@index([secretId])
  @@index([sudoSecretId])
  @@map("server_access")
}

/// What was found on a server, as JSON, and when and how. Empty until the SSH layer collects facts.
model ServerFact {
  serverId     String   @id @map("server_id") @db.Uuid
  facts        Json
  collectedAt  DateTime @map("collected_at") @db.Timestamptz(3)
  /// What produced it, for example `ssh`.
  source       String   @db.VarChar(16)
  /// The SHA-256 (hex) of the script that collected them; null for facts that were not collected by a script.
  scriptSha256 String?  @map("script_sha256") @db.VarChar(64)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_facts")
}

/// How much a script can change on a server (ADR 0038).
enum DangerLevel {
  read
  change
  destructive

  @@map("danger_level")
}

/// A run executes a stored script or a command typed in.
enum CommandRunMode {
  script
  inline

  @@map("command_run_mode")
}

enum CommandRunState {
  pending
  running
  succeeded
  failed
  cancelled
  partial

  @@map("command_run_state")
}

enum CommandTargetState {
  pending
  running
  succeeded
  failed
  lost
  cancelled
  skipped

  @@map("command_target_state")
}

/// A script of the library: the built-in diagnostics (seeded by name at start, never edited) and the instance's own.
model Script {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String      @unique @db.VarChar(64)
  description String      @db.VarChar(500)
  /// POSIX sh, LF line endings.
  body        String
  dangerLevel DangerLevel @map("danger_level")
  /// Runs as root through sudo (with the stored sudo secret when the login is not root).
  sudo        Boolean     @default(false)
  /// The typed parameter definitions, as JSON (`ScriptParameter[]` of packages/contracts).
  parameters  Json        @default("[]")
  builtin     Boolean     @default(false)
  /// Raised with every change of the text.
  version     Int         @default(1)
  /// SHA-256 of `body`, in hex.
  bodySha256  String      @map("body_sha256") @db.VarChar(64)
  /// The user who wrote it. No foreign key, like the audit chain.
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  runs CommandRun[]

  @@map("scripts")
}

/// One run of a script or a command on several servers. It keeps the exact text that ran, so the history stays true
/// when the script is edited or deleted later (ADR 0038).
model CommandRun {
  id                String          @id @default(uuid(7)) @db.Uuid
  mode              CommandRunMode
  state             CommandRunState @default(pending)
  /// The script it ran; null for an inline command, and after the script was deleted.
  scriptId          String?         @map("script_id") @db.Uuid
  /// The script's name and version when the run was made.
  scriptName        String?         @map("script_name") @db.VarChar(64)
  scriptVersion     Int?            @map("script_version")
  /// What the lists call it: the script's name, or the first line of the command.
  label             String          @db.VarChar(80)
  /// The exact text that ran (the script as it was, or the command).
  body              String
  bodySha256        String          @map("body_sha256") @db.VarChar(64)
  sudo              Boolean
  /// The level of the run: the script's, or what the person said of an inline command.
  dangerLevel       DangerLevel     @map("danger_level")
  /// The level the person confirmed; null for a `read` run.
  confirmedLevel    DangerLevel?    @map("confirmed_level")
  /// The parameter values given, as JSON.
  parameters        Json            @default("{}")
  timeoutSeconds    Int             @map("timeout_seconds")
  /// The user who started it, and the name at the time. No foreign key, like the audit chain.
  createdById       String?         @map("created_by_id") @db.Uuid
  createdByName     String          @map("created_by_name") @db.VarChar(64)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?       @map("finished_at") @db.Timestamptz(3)
  /// Set once when a person asks to stop the run; the targets that run are stopped by the runner.
  cancelRequestedAt DateTime?       @map("cancel_requested_at") @db.Timestamptz(3)

  script  Script?            @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  targets CommandRunTarget[]
  secrets CommandRunSecret[]

  @@index([createdAt])
  @@index([state])
  @@index([scriptId])
  @@map("command_runs")
}

/// One server of a run: its own state, exit status, errors and output. The output itself is in `CommandOutputChunk`
/// (appended as it is read, up to a limit); the target keeps how far that has got and the last bytes of each stream, so
/// that a poll of the run does not read the chunks, and a runner that restarts continues where it stopped.
model CommandRunTarget {
  id              String             @id @default(uuid(7)) @db.Uuid
  runId           String             @map("run_id") @db.Uuid
  /// The position in the order the servers were chosen.
  ordinal         Int
  /// Null after the server was deleted; the name below is what it was called.
  serverId        String?            @map("server_id") @db.Uuid
  serverName      String             @map("server_name") @db.VarChar(64)
  state           CommandTargetState @default(pending)
  /// The access entry that logged in (no foreign key: entries come and go).
  accessId        String?            @map("access_id") @db.Uuid
  /// The directory name of the detached step on the server, derived from this row's id.
  stepId          String             @map("step_id") @db.VarChar(64)
  /// The step exists on the server (it was started, or found there again).
  launched        Boolean            @default(false)
  exitCode        Int?               @map("exit_code")
  errorCode       String?            @map("error_code") @db.VarChar(40)
  errorMessage    String?            @map("error_message") @db.VarChar(500)
  /// A passing problem (the vault is sealed, the server cannot be reached for now) while the script runs on.
  waiting         String?            @db.VarChar(40)
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?          @map("finished_at") @db.Timestamptz(3)
  /// The last time the server answered about this step.
  lastContactAt   DateTime?          @map("last_contact_at") @db.Timestamptz(3)
  /// The last bytes of the kept output (at most 16 KiB), for the run view.
  stdoutTail      Bytes              @map("stdout_tail")
  /// How many bytes are kept (after a secret of the run was scrubbed out of them): the offsets of the stored chunks.
  stdoutStored    Int                @default(0) @map("stdout_stored")
  /// How far the server's stdout file has been read: where the next read starts. Equal to `stdoutStored` unless the
  /// run was handed secrets, because replacing a value with its marker changes the length (ADR 0042).
  stdoutRead      Int                @default(0) @map("stdout_read")
  /// How many bytes the server's stdout file holds, as last seen.
  stdoutSize      Int                @default(0) @map("stdout_size")
  stdoutTruncated Boolean            @default(false) @map("stdout_truncated")
  stderrTail      Bytes              @map("stderr_tail")
  stderrStored    Int                @default(0) @map("stderr_stored")
  stderrRead      Int                @default(0) @map("stderr_read")
  stderrSize      Int                @default(0) @map("stderr_size")
  stderrTruncated Boolean            @default(false) @map("stderr_truncated")

  run    CommandRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  server Server?               @relation(fields: [serverId], references: [id], onDelete: SetNull)
  chunks CommandOutputChunk[]

  @@index([runId, ordinal])
  @@index([serverId])
  @@index([state])
  @@map("command_run_targets")
}

/// A vault secret handed to a run as a file the runner writes for the length of the run and removes afterwards (ADR
/// 0042). The run keeps which secret, under which name, and which version was meant: never a value.
model CommandRunSecret {
  runId         String  @map("run_id") @db.Uuid
  /// The name the script knows it by: the file is `<step dir>/secrets/<name>`, `<name>_FILE` points at it.
  name          String  @db.VarChar(64)
  /// Null after the secret was deleted (once the run is over); the name below is what it was called.
  secretId      String? @map("secret_id") @db.Uuid
  secretName    String  @map("secret_name") @db.VarChar(100)
  /// The version of the value that is to be delivered: a value replaced before the delivery is not delivered.
  secretVersion Int     @map("secret_version")

  run    CommandRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  secret Secret?    @relation(fields: [secretId], references: [id], onDelete: SetNull)

  @@id([runId, name])
  @@index([secretId])
  @@map("command_run_secrets")
}

enum OutputStream {
  stdout
  stderr

  @@map("output_stream")
}

/// A piece of the output of one stream, as it was read from the server: raw bytes (a piece may end inside a UTF-8
/// character, and a script may print a NUL). `startOffset` is where it starts in the kept stream, so that reading the
/// same piece twice (a restart) is refused by the key and a page is a range of offsets.
model CommandOutputChunk {
  targetId    String           @map("target_id") @db.Uuid
  stream      OutputStream
  startOffset Int              @map("start_offset")
  data        Bytes

  target CommandRunTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@id([targetId, stream, startOffset])
  @@map("command_output_chunks")
}

/// Where Swellwright put a file of the artifact catalogue on a server: the user's home (`user`) or the root-owned
/// system directory (`system`). ADR 0039.
enum ArtifactDestination {
  user
  system

  @@map("artifact_destination")
}

/// What the last check of a copy on a server found: it hashes to the expected value, to another one, or is gone.
enum ArtifactCheckState {
  ok
  differs
  missing

  @@map("artifact_check_state")
}

/// A copy of an artifact version on a server, as Swellwright pushed it. One row per server, artifact and version:
/// the copy is immutable, so a version is either there or not. The path is what the push recorded; removing and
/// checking use it only after it is matched against the layout. No foreign key to the user who pushed it, like the
/// audit chain.
model ServerArtifact {
  id           String              @id @default(uuid(7)) @db.Uuid
  serverId     String              @map("server_id") @db.Uuid
  /// The artifact name and version of the catalogue at the time of the push.
  name         String              @db.VarChar(64)
  version      String              @db.VarChar(32)
  /// The SHA-256 (hex) the catalogue declared, which the copy was checked against, and its size in bytes.
  sha256       String              @db.VarChar(64)
  size         Int
  destination  ArtifactDestination @default(user)
  /// The absolute path of the file on the server.
  remotePath   String              @map("remote_path") @db.VarChar(1024)
  pushedAt     DateTime            @map("pushed_at") @db.Timestamptz(3)
  pushedById   String?             @map("pushed_by_id") @db.Uuid
  /// The last check after the push: when, what it found and what the copy hashed to (null when it was missing).
  verifiedAt   DateTime?           @map("verified_at") @db.Timestamptz(3)
  verifyState  ArtifactCheckState? @map("verify_state")
  remoteSha256 String?             @map("remote_sha256") @db.VarChar(64)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name, version])
  @@map("server_artifacts")
}

/// What the last check of a panel connection found (ADR 0041). There is no `unconfigured` here: that is a missing row.
enum PanelConnectionState {
  connected
  degraded
  unreachable
  unauthorized
  unsupported

  @@map("panel_connection_state")
}

/// The connection to a Remnawave panel: where it is, which vault secret holds its API token, and what the last check
/// found (ADR 0041). One row is used for now; nothing in the shape prevents several. The token is never stored here.
model PanelConnection {
  id               String               @id @default(uuid(7)) @db.Uuid
  /// `https://host[:port][/prefix]`, normalised, no credentials, query or fragment.
  baseUrl          String               @map("base_url") @db.VarChar(2048)
  /// The vault secret (kind `panel_token`). Restricts on delete: the secret cannot be removed while this uses it.
  tokenSecretId    String               @map("token_secret_id") @db.Uuid
  state            PanelConnectionState
  panelVersion     String?              @map("panel_version") @db.VarChar(64)
  /// What the token can read, found by the last check: `{ checkedAt, resources: { nodes: "ok", ... } }`.
  capabilities     Json?
  /// PEM text of an authority to trust for this panel (public material).
  trustedCa        String?              @map("trusted_ca") @db.VarChar(20000)
  /// When the token expires, read from the token itself when it carries an expiry claim.
  tokenExpiresAt   DateTime?            @map("token_expires_at") @db.Timestamptz(3)
  lastCheckedAt    DateTime?            @map("last_checked_at") @db.Timestamptz(3)
  lastErrorCode    String?              @map("last_error_code") @db.VarChar(64)
  lastErrorMessage String?              @map("last_error_message") @db.VarChar(500)
  /// The user who connected it. No foreign key, like the audit chain.
  createdById      String?              @map("created_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tokenSecret Secret @relation("PanelConnectionToken", fields: [tokenSecretId], references: [id], onDelete: Restrict)

  @@index([tokenSecretId])
  @@map("panel_connections")
}

/// A saved convention pack (ADR 0044): the rules, parameters, patterns and thresholds that the convention linter, the
/// reconciliation and the impact calculator run with. Every save is a new version and one version is active; no active
/// version means that the built-in pack applies. The document holds no secret.
model ConventionPack {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Which panel it is for. `default` while Swellwright talks to one panel: a reconnect replaces the connection row
  /// (ADR 0041), and the conventions of an installation must outlive a rotation of the token.
  panelKey    String   @default("default") @map("panel_key") @db.VarChar(32)
  version     Int
  name        String   @db.VarChar(100)
  /// The document as it was validated.
  document    Json
  /// The text as the user wrote it (YAML or JSON), with its comments.
  source      String   @db.Text
  /// SHA-256 (hex) of the canonical JSON of the document.
  hash        String   @db.VarChar(64)
  active      Boolean  @default(false)
  comment     String?  @db.VarChar(500)
  /// The user who saved it. No foreign key, like the audit chain.
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([panelKey, version])
  @@index([panelKey, active])
  @@map("convention_packs")
}

/// Where a snapshot of the panel came from (ADR 0043). `before_change` and `imported` are reserved for later phases.
enum PanelSnapshotKind {
  manual
  scheduled
  before_change
  imported

  @@map("panel_snapshot_kind")
}

/// A snapshot of the objects of a Remnawave panel at one moment (ADR 0043): masked, normalised, hashed per object and
/// as a whole. What it holds is in `PanelSnapshotContent`, so that a list of snapshots does not read the content. It
/// belongs to a panel by its address and not to a connection: a connection is replaced when its token is rotated, and
/// the history must survive that, so there is no foreign key and `connectionId` is only a note.
model PanelSnapshot {
  id            String            @id @default(uuid(7)) @db.Uuid
  connectionId  String?           @map("connection_id") @db.Uuid
  /// The address of the panel it was taken from (normalised, as `PanelConnection.baseUrl`).
  panelUrl      String            @map("panel_url") @db.VarChar(2048)
  label         String?           @db.VarChar(100)
  kind          PanelSnapshotKind
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Who took it; null for the background job. No foreign key, like the audit chain; the name is the one at that time.
  createdById   String?           @map("created_by_id") @db.Uuid
  createdByName String?           @map("created_by_name") @db.VarChar(64)
  panelVersion  String?           @map("panel_version") @db.VarChar(64)
  /// Objects per kind (0 for a kind that is not covered), and per kind whether it was read: `ok`, `denied`, `failed`.
  counts        Json
  coverage      Json
  objectCount   Int               @map("object_count")
  /// SHA-256 over the (id, hash) pairs of every covered object, and the same per kind.
  overallHash   String            @map("overall_hash") @db.VarChar(64)
  kindHashes    Json              @map("kind_hashes")
  /// A public identifier of the key that made the fingerprints of the masks (see ADR 0043).
  maskKeyId     String            @map("mask_key_id") @db.VarChar(16)
  /// The size of the content as JSON and as stored (gzip).
  rawBytes      Int               @map("raw_bytes")
  sizeBytes     Int               @map("size_bytes")
  /// When the panel was last compared with this snapshot (the background job or a comparison with the live panel), and
  /// how many objects differed then; 0 when the panel was found the same.
  checkedAt     DateTime?         @map("checked_at") @db.Timestamptz(3)
  changesSince  Int?              @map("changes_since")

  content PanelSnapshotContent?

  @@index([panelUrl, createdAt(sort: Desc)])
  @@map("panel_snapshots")
}

/// The content of a snapshot: the JSON of `{ format, schemaVersion, maskKeyId, kinds }`, gzipped, with the SHA-256 of
/// the stored bytes so that a corrupted row is found when it is read.
model PanelSnapshotContent {
  snapshotId String @id @map("snapshot_id") @db.Uuid
  encoding   String @db.VarChar(16)
  data       Bytes
  sha256     String @db.VarChar(64)

  snapshot PanelSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("panel_snapshot_contents")
}
