{
  "name": "@swellwright/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared UI: the Remnawave panel theme tokens, the compact application header and basic components",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./table-state": {
      "types": "./dist/table-state.d.ts",
      "default": "./dist/table-state.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kastov/mantine-datatable": "9.3.4",
    "@kastov/mantine-react-table-open": "9.0.12",
    "@tabler/icons-react": "3.46.0",
    "clsx": "2.1.1",
    "color-hash": "2.0.2",
    "dayjs": "1.11.23",
    "motion": "12.42.2",
    "react-country-flag": "3.1.0",
    "react-icons": "5.7.0"
  },
  "peerDependencies": {
    "@mantine/core": "9.5.2",
    "@mantine/dates": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mantine/core": "9.5.2",
    "@mantine/dates": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@types/color-hash": "2.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
