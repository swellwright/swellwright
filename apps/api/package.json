{
  "name": "@swellwright/api",
  "version": "0.0.0",
  "private": true,
  "description": "REST API, WebSocket gateways, authorization and the OpenAPI document",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/**/*.test.js\"",
    "start": "node dist/main.js",
    "admin": "node --env-file-if-exists=../../.env dist/admin.js",
    "dev": "node --watch --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@swellwright/contracts": "workspace:*",
    "@swellwright/conventions": "workspace:*",
    "@swellwright/db": "workspace:*",
    "@swellwright/plugin-api": "workspace:*",
    "@swellwright/remnawave": "workspace:*",
    "@swellwright/ssh": "workspace:*",
    "iovalkey": "0.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.6",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/semver": "7.8.0"
  }
}
