# Copy to .env next to docker-compose.yml and fill in the three secrets. Never commit .env.
# Values are used as they are: no quotes, and no `$` (Compose would read it as a variable).

# The password of the database user. It ends up in a URL, so use hexadecimal characters only:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Seals the authenticator secrets in the database (ADR 0014). 32 random bytes in base64:
#   openssl rand -base64 32
# Keep a copy somewhere safe. Without it nobody can sign in with an authenticator and every user has to
# set it up again.
SW_AUTH_KEY=

# The one-time token the first visitor needs to create the owner (16 or more characters). Remove it from
# this file once the owner exists; without it the server prints a random token to its log at every start.
#   openssl rand -hex 24
SW_SETUP_TOKEN=

# --- Optional ---------------------------------------------------------------------------------------------

# Where the server is published on the host. The default listens on the loopback address only; the reverse
# proxy with TLS in front of it is the only thing that should reach it.
# SW_LISTEN=127.0.0.1:3100

# Required: uncomment and set the reverse proxy's peer address as seen by the API, or an exclusive proxy
# CIDR. Do not trust a network shared with plugin sidecars. Use false only when clients connect directly.
# SW_TRUSTED_PROXIES=false

# The origins that may send changing requests, when the console is opened under a name that differs from the
# Host header the proxy passes on. Comma-separated, like https://console.example.com
# SW_ALLOWED_ORIGINS=

# Session cookies get the Secure attribute (the default in production). Browsers accept them on
# http://localhost and http://127.0.0.1 too; set this to false only to test over plain HTTP from elsewhere.
# SW_COOKIE_SECURE=true

# Minutes a session stays elevated after the second factor (1 to 30, ADR 0017), and the other limits of
# .env.example in the repository root work the same here.
# SW_STEP_UP_MINUTES=5

# The server asks api.github.com once a day for the newest release and the star count of the project, for the
# version button of the console (a plain GET; nothing that identifies this installation is sent). off sends
# nothing, ever. SW_REPOSITORY (owner/name) names the repository of a fork.
# SW_UPDATE_CHECK=on

# The image: built from this checkout and tagged with this name.
# SW_IMAGE_TAG=local
