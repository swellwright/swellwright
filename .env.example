# Copy to .env (never commit .env). Development values only.
SW_HTTP_HOST=127.0.0.1
SW_HTTP_PORT=3000

# Postgres and Valkey from deploy/compose/docker-compose.dev.yml. Leave empty to skip their checks.
# Create the schema with `pnpm run db:migrate:deploy`; /ready reports not_ready until it is applied.
SW_DATABASE_URL=postgresql://sw:swellwright-dev@127.0.0.1:5432/swellwright
SW_VALKEY_URL=redis://127.0.0.1:6379

# Seals the authenticator secrets in the database (ADR 0014). Required in production; if empty, development
# makes a temporary one per process. Make one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SW_AUTH_KEY=

# First run: the API prints a one-time setup token to its log. Set this to use a fixed one (16+ characters).
# SW_SETUP_TOKEN=

# Optional: the directory with the built console (apps/web/dist). When set, the API serves it at / (the container image
# sets it). Without it the console is started on its own with `pnpm --filter @swellwright/web dev`.
# SW_WEB_DIR=

# Optional: which proxies in front of the API may say who the client is (X-Forwarded-For): a number of hops, or
# addresses, CIDR ranges and the names loopback, linklocal, uniquelocal. Not set: nobody is trusted.
# SW_TRUSTED_PROXIES=

# Optional: how long a session stays elevated after the second factor (step-up, ADR 0017). Default 5, 1 to 30.
# SW_STEP_UP_MINUTES=5

# Optional: the Argon2id cost of a new vault passphrase (ADR 0018). Default 256 MiB and 3 passes; at least 64 MiB.
# SW_VAULT_KDF_MEMORY_MIB=256
# SW_VAULT_KDF_PASSES=3

# Where plugins are looked for: one sub-directory per plugin (docs/adr/0027). Not set: no plugins.
# SW_PLUGINS_OFFICIAL_DIR=
# SW_PLUGINS_LOCAL_DIR=
# Plugins by others: sidecar containers and declarative drivers only (docs/adr/0031).
# SW_PLUGINS_COMMUNITY_DIR=
# How a sidecar reaches Swellwright, how Swellwright reaches a sidecar, and the compose names the fragment uses.
# SW_PLUGIN_CORE_URL=http://swellwright:3000
# SW_PLUGIN_SIDECAR_URL=http://plugin-{id}:{port}
# SW_PLUGIN_NETWORK=plugins
# SW_PLUGIN_CORE_SERVICE=swellwright
# How plugin processes are held (docs/adr/0028): heap in MiB, seconds per call, idle minutes before a stop.
# SW_PLUGIN_MEMORY_MIB=128
# SW_PLUGIN_CALL_TIMEOUT_SECONDS=10
# SW_PLUGIN_IDLE_MINUTES=10

# Servers over SSH (docs/adr/0037). Which addresses Swellwright may connect to: loopback is the machine it runs on
# (refused by default); private ranges and host names are allowed by default. Link-local and cloud metadata
# addresses are never allowed. Seconds to connect and log in, seconds for one command (the facts script), and how
# many scans, checks and refreshes one user may start per minute.
# SW_SSH_ALLOW_LOOPBACK=false
# SW_SSH_ALLOW_PRIVATE=true
# SW_SSH_ALLOW_HOSTNAMES=true
# SW_SSH_CONNECT_TIMEOUT_SECONDS=15
# SW_SSH_COMMAND_TIMEOUT_SECONDS=60
# SW_SSH_RATE_LIMIT_PER_MINUTE=20

# Scripts and commands on servers (docs/adr/0038). How many servers of one run are worked on at the same time, how much of
# each output stream of each server is kept (KiB; the rest is cut and the run says so), how often a running script is looked
# at (ms; it slows down by itself while nothing new arrives), how long a running server may stay out of reach before its
# result is given up as lost (minutes), and how many runs one user may start per minute.
# SW_COMMAND_CONCURRENCY=5
# SW_COMMAND_OUTPUT_LIMIT_KIB=1024
# SW_COMMAND_POLL_MS=1000
# SW_COMMAND_LOST_AFTER_MINUTES=30
# SW_COMMAND_RATE_LIMIT_PER_MINUTE=10

# Artifacts (docs/adr/0039). The catalogue of built-in artifacts (default: the artifacts directory of the repository,
# which the container image carries), the biggest file one may be (a push holds the file in memory) and how many
# pushes, checks and removals one user may start per minute.
# SW_ARTIFACTS_DIR=
# SW_ARTIFACT_MAX_BYTES=67108864
# SW_ARTIFACT_RATE_LIMIT_PER_MINUTE=10

# The Remnawave panel (docs/adr/0041). The address of the panel is checked like an SSH target: loopback is the machine
# Swellwright runs on (refused by default), private ranges and host names are allowed, link-local and cloud metadata
# addresses never are. Plain http only for a loopback or private address, and only when allowed. The panel's TLS
# certificate is always verified; give a private authority to one panel in the wizard instead of turning that off.
# Seconds for one request and for the connection, the biggest answer taken (MiB), how long an answer is kept in memory
# (seconds; 0 keeps nothing), how often the connected panel is checked in the background (minutes; 0 never), and how
# many forced reads and connection tests one user may start per minute.
# SW_PANEL_ALLOW_HTTP=false
# SW_PANEL_ALLOW_LOOPBACK=false
# SW_PANEL_ALLOW_PRIVATE=true
# SW_PANEL_ALLOW_HOSTNAMES=true
# SW_PANEL_ALLOW_INSECURE_TLS=false
# SW_PANEL_TIMEOUT_SECONDS=15
# SW_PANEL_CONNECT_TIMEOUT_SECONDS=5
# SW_PANEL_MAX_RESPONSE_MIB=16
# SW_PANEL_CACHE_TTL_SECONDS=15
# SW_PANEL_CHECK_INTERVAL_MINUTES=5
# SW_PANEL_REFRESH_RATE_LIMIT_PER_MINUTE=12
# SW_PANEL_TEST_RATE_LIMIT_PER_MINUTE=10

# The checks of Panel > Checks (docs/adr/0044, docs/en/conventions.md). Reconciliation looks names up in DNS under limits:
# seconds for one lookup, the most names looked up in one run, lookups at the same time, how long an answer is remembered
# (seconds; 0 remembers nothing), the resolvers to ask (a comma-separated list of IP addresses, with an optional port;
# empty uses the resolver of the system) and how many reconciliations one user may start per minute.
# SW_CHECKS_DNS_TIMEOUT_SECONDS=3
# SW_CHECKS_DNS_MAX_NAMES=200
# SW_CHECKS_DNS_CONCURRENCY=8
# SW_CHECKS_DNS_CACHE_SECONDS=60
# SW_CHECKS_DNS_SERVERS=
# SW_CHECKS_RATE_LIMIT_PER_MINUTE=12

# Snapshots of the panel (docs/adr/0043): a snapshot is the masked configuration of every object the token may read.
# How many are kept at least (the newest snapshot of each of the last 14 days is kept as well), how often the
# background job looks at the panel while it is connected and the vault is open (hours; 0 switches the job off; a
# snapshot is taken only when the panel changed), and the most one snapshot may hold before compression (MiB).
# SW_PANEL_SNAPSHOT_KEEP=50
# SW_PANEL_SNAPSHOT_INTERVAL_HOURS=24
# SW_PANEL_SNAPSHOT_MAX_MIB=32

# Optional: validate every response against its contract (default: on outside production).
# SW_VALIDATE_RESPONSES=true

# Optional: the server asks api.github.com once a day for the newest release and the star count of the project
# (a plain GET; nothing that identifies this installation, a user or a browser is sent). `off` sends nothing, ever.
# SW_UPDATE_CHECK=on
# The repository that is asked about (owner/name), for a fork or a mirror.
# SW_REPOSITORY=swellwright/swellwright
# Where the check asks. For tests only (a stand-in server on the same machine): https, or http on localhost.
# SW_UPDATE_API_BASE=https://api.github.com
